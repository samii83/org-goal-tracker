# Org Goal Tracker Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration
# Default: Persistent SQLite database (no external setup required)
# If DATABASE_URL is left empty or omitted, SQLite is used automatically:
# DATABASE_URL=sqlite:///./goaltrack.db

# Optional MySQL configuration:
# To use MySQL, set DATABASE_URL (the app will NOT silently fallback to SQLite if MySQL fails):
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/org_goal_tracker

# Security & Cookie Sessions
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
SESSION_COOKIE_NAME=goaltrack_session
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false

# CORS (Allowed origins for development frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
